<h1><%= @list.name %></h1>

<%= link_to "Return to Lists", lists_path %>
<%= link_to "Add a movie to this list", new_list_bookmark_path(@list) %>

<% @list.bookmarks.each do |bookmark| %>
<li><%= bookmark.movie.title %> -- <%= bookmark.comment %><%= link_to "Remove", bookmark_path(bookmark), data: { turbo_method: :delete, turbo_confirm: "Sure?" } %></li>
<% end %>
